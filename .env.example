# =========================================================================
# GoContract Backend — .env.example
# Copy this file to `.env` and fill in real values for your environment.
# Do NOT commit `.env`. Only commit this `.env.example` template.
# =========================================================================

# ---- Database ----
# Postgres connection string. The app rewrites postgres:// and postgresql://
# to postgresql+asyncpg:// automatically.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gocontract

# ---- Security / Auth ----
JWT_SECRET=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256

# ---- OpenAI ----
OPENAI_API_KEY=sk-xxx-replace-me

# ---- Email (Resend) ----
RESEND_API_KEY=re_replace_me
FROM_EMAIL=onboarding@resend.dev

# ---- App ----
ENVIRONMENT=local
PROJECT_NAME=GoContractAI
FRONTEND_URL=http://localhost:5173

# =========================================================================
# Stripe (Phase 1 — Stripe monetization integration)
# Obtain test keys from https://dashboard.stripe.com/test/apikeys
# =========================================================================

# Secret API key. Use sk_test_* for development, sk_live_* in production.
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key (pk_*). Currently NOT used server-side, but documented for
# parity with frontend env.
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Webhook signing secret. Obtained from `stripe listen` (whsec_*) locally or
# from the Stripe Dashboard → Developers → Webhooks for production.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Pinned Stripe API version. Avoid auto-updates that could break integrations.
STRIPE_API_VERSION=2024-11-20.acacia

# Redirect URLs for Stripe Checkout. Leave empty to default to
# `${FRONTEND_URL}/billing/success?session_id={CHECKOUT_SESSION_ID}` and
# `${FRONTEND_URL}/billing/cancel`. Override here if your frontend lives on
# a different path.
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
